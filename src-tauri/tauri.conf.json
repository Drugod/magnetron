{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MAGNETRON",
  "version": "0.9.0",
  "identifier": "local.magnetforge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MAGNETRON",
        "width": 1250,
        "height": 850,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "ed2k",
          "magnet"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Unified BitTorrent and eD2k search and downloads",
    "license": "GPL-3.0-only",
    "category": "Utility",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": [
          "Spanish"
        ]
      }
    },
    "resources": {
      "../LICENSE": "licenses/MAGNETRON-GPL-3.0.txt",
      "../artifacts/licenses/librqbit-LICENSE.txt": "licenses/librqbit-LICENSE.txt",
      "../artifacts/licenses/THIRD-PARTY-NOTICES.txt": "licenses/THIRD-PARTY-NOTICES.txt"
    }
  }
}
