{
  "name": "magnetforge",
  "version": "0.9.1",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop.ps1 dev",
    "bundle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop.ps1 build",
    "test:rust": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop.ps1 test",
    "prepare:native": "python3 scripts/prepare-native.py",
    "desktop:native": "npm run tauri -- dev",
    "bundle:native": "npm run tauri -- build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "axe-core": "4.14.0",
    "jsdom": "^30.1.3",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "decimal.js": "10.6.0"
  }
}
